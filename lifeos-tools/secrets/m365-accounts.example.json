{
  "accounts": [
    {
      "alias": "ut",
      "auth_provider": "graph-powershell",
      "tenant": "organizations",
      "mail": {
        "enabled": true,
        "days": 30,
        "max_results": 150,
        "body_character_limit": 8000,
        "write_enabled": false,
        "max_moves_per_call": 50,
        "rules_enabled": false
      },
      "calendar": {
        "enabled": true,
        "calendar_ids": [
          "primary"
        ],
        "writable_calendar_ids": [
          "primary"
        ],
        "timezone": "Central Standard Time",
        "description_character_limit": 8000
      },
      "contacts": {
        "enabled": true,
        "max_results": 500,
        "notes_character_limit": 4000
      },
      "files": {
        "enabled": false
      },
      "planner": {
        "enabled": false,
        "write_enabled": false,
        "sync": true,
        "max_tasks": 500,
        "description_character_limit": 2000,
        "plans": [
          {
            "id": "example-plan-id",
            "name": "Project Tracker",
            "context": "Example: a team plan for a campus job."
          }
        ]
      }
    }
  ]
}
